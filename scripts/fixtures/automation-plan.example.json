{
  "version": 1,
  "title": "打开个人页并验证",
  "backend": "uiautomator",
  "timeoutMs": 60000,
  "startConditions": [
    { "selector": { "resourceId": "com.example.app:id/home_title" }, "state": "visible" }
  ],
  "steps": [
    {
      "id": "open_profile",
      "kind": "step",
      "input": {
        "target": { "selector": { "resourceId": "com.example.app:id/profile_tab" } },
        "action": { "kind": "tap" },
        "expect": { "selector": { "resourceId": "com.example.app:id/profile_title" }, "state": "visible" },
        "timeoutMs": 10000
      }
    }
  ],
  "finalConditions": [
    { "selector": { "resourceId": "com.example.app:id/profile_title" }, "state": "visible" }
  ]
}
