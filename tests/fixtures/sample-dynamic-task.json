        { "id": "ready_updated_absent", "selector": { "text": "UPDATED CHILD", "className": "android.widget.TextView" }, "state": "absent" },
        { "id": "ready_new_absent", "selector": { "text": "NEW VIEW", "className": "android.widget.TextView" }, "state": "absent" }
      ]
    }
  ],
  "finalConditions": [
    { "id": "final_updated_visible", "selector": { "text": "UPDATED CHILD", "className": "android.widget.TextView" }, "state": "visible" },
    { "id": "final_new_visible", "selector": { "text": "NEW VIEW", "className": "android.widget.TextView" }, "state": "visible" },
    { "id": "final_red_absent", "selector": { "text": "RED CHILD", "className": "android.widget.TextView" }, "state": "absent" }
